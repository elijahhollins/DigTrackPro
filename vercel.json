{
  "headers": [
    {
      "source": "/(.*)\\.mjs",
      "headers": [{ "key": "Content-Type", "value": "text/javascript" }]
    },
    {
      "source": "/sw.js",
      "headers": [
        { "key": "Content-Type", "value": "text/javascript" },
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Service-Worker-Allowed", "value": "/" }
      ]
    },
    {
      "source": "/manifest.json",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ],
  "rewrites": [
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/walkthrough", "destination": "/walkthrough.html" },
    { "source": "/videos/jobs-labor-costs", "destination": "/tutorial-jobs-labor-costs.html" },
    { "source": "/((?!api/|sw\\.js|manifest\\.json|terms\\.html|privacy\\.html|walkthrough\\.html|tutorial-jobs-labor-costs\\.html).*)", "destination": "/index.html" }
  ]
}
